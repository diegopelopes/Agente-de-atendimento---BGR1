# ============================================================================
# BGR BENEFÍCIOS — AGENTE COMERCIAL IA
# Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
# REGRA DE SEGURANÇA: Copie para .env localmente. NUNCA comite tokens reais!
# ============================================================================

# --- Ambiente e Identificação Multi-Tenant ---
NODE_ENV=development
APP_ENV=teste
COMPANY_ID=bgr_beneficios
COMPANY_NAME="BGR Benefícios"
COMPANY_SEGMENT=protecao_veicular
PORT=3000

# --- Inteligência Artificial (LLM) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.4
OPENAI_MAX_TOKENS=1024
SESSION_MEMORY_WINDOW=20

# --- Integração Power CRM ---
# Modo de operação do adapter: "mock" (padrão seguro em dev/teste) ou "http" (requer autorização)
POWERCRM_MODE=mock
POWERCRM_BASE_URL=https://api.powercrm.com.br/api/v1
POWERCRM_INTEGRATION_NAME="Agente IA - BGR Protótipo"
POWERCRM_BEARER_TOKEN=
POWERCRM_TIMEOUT_MS=10000
POWERCRM_MAX_RETRIES_GET=2

# --- WhatsApp Business Cloud API (Fase 5 - Desativado por padrão) ---
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v18.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- Governança, Campanhas e Follow-up (Fase 6) ---
FOLLOWUP_ENABLED=false
FOLLOWUP_START_HOUR_BRT=09:00
FOLLOWUP_END_HOUR_BRT=18:00
FOLLOWUP_MAX_ATTEMPTS=3
CAMPAIGN_ENABLED=false
CAMPAIGN_DAILY_LIMIT=100
CAMPAIGN_BATCH_SIZE=10
CAMPAIGN_BATCH_INTERVAL_SEC=30

# --- Filas de Transferência Humana (Handoff) ---
HANDOFF_QUEUE_COMERCIAL=fila_comercial_bgr
HANDOFF_QUEUE_SUPORTE=fila_suporte_bgr
HANDOFF_QUEUE_SINISTROS=fila_sinistros_bgr
HANDOFF_QUEUE_FINANCEIRO=fila_financeiro_bgr
HANDOFF_ALERT_EMAIL=

# --- Observabilidade e Auditoria ---
LOG_LEVEL=info
AUDIT_HASH_SALT=trocar_por_salt_aleatorio_local
DATABASE_URL=
