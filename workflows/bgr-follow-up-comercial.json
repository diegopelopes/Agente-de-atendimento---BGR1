      "parameters": {
        "method": "POST",
        "url": "https://YOUR_WHATSAPP_API_URL/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
