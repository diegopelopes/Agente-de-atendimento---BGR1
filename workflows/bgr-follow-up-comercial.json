      "typeVersion": 4.2,
      "position": [1160, 800],
      "disabled": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "WhatsApp Business API - BGR"
        }
      },
      "notesInFlow": true,
      "notes": "Envia template de follow-up para leads em negociação."
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://api.powercrm.com.br/api/v1/leads/{{ $json.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"last_followup_at\": \"{{ $now.toISO() }}\",\n  \"followup_count\": {{ ($json.followup_count || 0) + 1 }},\n  \"notes\": \"Follow-up automático enviado via WhatsApp em {{ $now.format('dd/MM/yyyy HH:mm') }}\"\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        }
      },
      "id": "atualizar-status-crm-001",
