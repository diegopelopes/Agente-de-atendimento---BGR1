{
  "name": "BGR - Campanha Reativação Ex-Associados - v1.0",
  "nodes": [
    {
      "parameters": {},
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Iniciar Campanha",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "operation": "fromJson",
        "options": {}
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Importar Lista de Contatos",
      "type": "n8n-nodes-base.spreadsheetFile",
      "typeVersion": 2,
      "position": [
        60,
        300
      ],
      "notesInFlow": true,
      "notes": "Lê arquivos CSV/XLSX com colunas:\nid_cliente, nome, telefone, status_anterior,\ndata_ultima_associacao, motivo_saida,\nhistorico_comercial, autorizacao_contato,\ndata_autorizacao, origem_autorizacao"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "condition-auth-sim",
              "leftValue": "={{ $json.autorizacao_contato }}",
              "rightValue": "sim",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "condition-auth-true",
              "leftValue": "={{ $json.autorizacao_contato }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Filtrar Autorizados",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        320,
        300
      ],
      "notesInFlow": true,
      "notes": "LGPD: Filtra apenas contatos com autorização explícita.\nautorizacao_contato == 'sim' ou 'true'"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "condition-optout",
              "leftValue": "={{ $json.telefone }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Verificar Descadastro",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        580,
        300
      ],
      "notesInFlow": true,
      "notes": "PLACEHOLDER: Verificar se o contato está na lista de opt-out.\nImplementar consulta à lista interna de descadastro.\nRemover contatos que solicitaram exclusão."
    },
    {
      "parameters": {
        "options": {
          "reset": false
        },
        "batchSize": 10
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Controle de Lotes",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        840,
        300
      ],
      "notesInFlow": true,
      "notes": "Processa 10 contatos por lote para respeitar\nos limites de envio do WhatsApp Business Platform."
    },
    {
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Intervalo entre Envios",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1100,
        300
      ],
      "notesInFlow": true,
      "notes": "Aguarda 30 segundos entre lotes para\nnão exceder limites da API do WhatsApp."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v18.0/{PHONE_NUMBER_ID}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"recipient_type\": \"individual\",\n  \"to\": \"{{ $json.telefone }}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"bgr_reativacao\",\n    \"language\": {\n      \"code\": \"pt_BR\"\n    },\n    \"components\": [\n      {\n        \"type\": \"body\",\n        \"parameters\": [\n          {\n            \"type\": \"text\",\n            \"text\": \"{{ $json.nome }}\"\n          }\n        ]\n      }\n    ]\n  }\n}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          },
          "timeout": 30000
        }
      },
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Enviar Mensagem Template",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1360,
        300
      ],
      "disabled": true,
      "notesInFlow": true,
      "notes": "⚠️ DESABILITADO: Ativar somente após:\n1. Template 'bgr_reativacao' aprovado pela Meta\n2. Credenciais configuradas no n8n\n3. PHONE_NUMBER_ID substituído na URL\n4. Validação jurídica LGPD concluída",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://{POWER_CRM_API_URL}/api/v1/leads",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"id_cliente\": \"{{ $json.id_cliente }}\",\n  \"nome\": \"{{ $json.nome }}\",\n  \"telefone\": \"{{ $json.telefone }}\",\n  \"status\": \"Campanha Enviada\",\n  \"campanha\": \"BGR - Reativação Ex-Associados\",\n  \"data_envio\": \"{{ $now.toISO() }}\",\n  \"canal\": \"whatsapp\",\n  \"motivo_saida_original\": \"{{ $json.motivo_saida }}\",\n  \"data_ultima_associacao\": \"{{ $json.data_ultima_associacao }}\"\n}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          },
          "timeout": 30000
        }
      },
      "id": "a1b2c3d4-0008-4000-8000-000000000008",
      "name": "Registrar Envio no CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1620,
        300
      ],
      "disabled": true,
      "notesInFlow": true,
      "notes": "⚠️ DESABILITADO: Configurar endpoint do Power CRM.\nSubstituir {POWER_CRM_API_URL} pela URL real.\nConfigurar credenciais de autenticação.",
      "onError": "continueErrorOutput"
    },
